#!/bin/bash
#PBS -N rq1_base_ktest
#PBS -q normal
#PBS -P personal-tejasvit
#PBS -l select=1:ncpus=4:mem=24gb:ngpus=1
#PBS -l walltime=06:00:00
#PBS -j oe
#PBS -o /home/users/ntu/tejasvit/scratch/reasoning-image-edit/logs/rq1_base_ktest.log

set -e

PROJECT_ROOT=/home/users/ntu/tejasvit/scratch/reasoning-image-edit
ENV_PATH=/home/users/ntu/tejasvit/scratch/conda_envs/step1x

echo "========================================"
echo "RQ1 Base K-dev"
echo "========================================"
echo "Job ID: ${PBS_JOBID}"
echo "Node: $(hostname)"
echo "Start: $(date)"
echo "Project: ${PROJECT_ROOT}"
echo "========================================"

module purge
module load miniforge3

conda activate ${ENV_PATH}

cd ${PROJECT_ROOT}

export HF_HOME=/home/users/ntu/tejasvit/scratch/hf_cache
export HUGGINGFACE_HUB_CACHE=${HF_HOME}/hub

mkdir -p logs
mkdir -p outputs/rq1/base

echo
echo "Python:"
which python

echo
echo "GPU:"
nvidia-smi

echo
echo "PyTorch / CUDA check:"
python - <<'PY'
import torch
from diffusers import Step1XEditPipelineV1P2

print("Torch:", torch.__version__)
print("Built CUDA:", torch.version.cuda)
print("CUDA available:", torch.cuda.is_available())
print("GPU count:", torch.cuda.device_count())

if torch.cuda.is_available():
    print("GPU:", torch.cuda.get_device_name(0))

print("Step1X import OK")
PY

echo
echo "========================================"
echo "Starting RQ1 Base K-dev"
echo "========================================"

python -u -m src.run_experiment \
    --config configs/base.yaml \
    --splits data/splits.json \
    --split k_test \
    --seed 42 \
    --stop-on-failure

echo
echo "========================================"
echo "Finished"
echo "End: $(date)"
echo "========================================"